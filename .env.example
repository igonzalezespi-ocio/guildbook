# Postgres. Local Docker (pnpm db:up) or a Neon connection string in production.
DATABASE_URL=postgres://osm:osm@localhost:5434/osm

# Auth.js — generate with: pnpm dlx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=
# Discord OAuth app (https://discord.com/developers/applications)
# Redirect URIs: http://localhost:3000/api/auth/callback/discord and in production
# https://guildbook.io/api/auth/callback/discord (sign-in only ever happens on the apex).
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# Required on Vercel preview/production behind a proxy
AUTH_TRUST_HOST=true

# Guildbook hosts. Production: ROOT_DOMAIN=guildbook.io, AUTH_COOKIE_DOMAIN=guildbook.io, ALT_DOMAINS empty.
# To add guildbook.gg later as an alias, set ALT_DOMAINS=guildbook.gg; to make .gg primary, swap the two.
# Locally leave ROOT_DOMAIN empty: the apex is localhost:3000 (www.localhost redirects there) and guilds live on
# <slug>.localhost:3000, so the Order is osm.localhost:3000.
ROOT_DOMAIN=
# Comma-separated domains that 308-redirect to ROOT_DOMAIN (same subdomain and path).
ALT_DOMAINS=
# Session cookie shared by the apex and every guild subdomain. Leave empty locally (browsers reject Domain=localhost;
# *.localhost and custom domains receive the session through a one-time handoff instead).
AUTH_COOKIE_DOMAIN=
# Guild served on hosts that aren't the apex or a guild (*.vercel.app previews, IPs). Empty makes those hosts
# serve the platform apex. Bare localhost is always the apex. `pnpm db:seed` also uses it as the demo guild's slug.
DEFAULT_GUILD_SLUG=osm
# Legacy dev fallback: "true" serves guilds at /<guild-slug>/... on one host instead of on subdomains.
NEXT_PUBLIC_MULTI_GUILD=false
# Guilds one account may own at once (founded and not deleted; deleting a guild frees a slot), and found per
# rolling day.
GUILD_CREATE_LIMIT=3
GUILD_CREATE_DAILY_LIMIT=2
# Per-account overrides of GUILD_CREATE_LIMIT, as discordId:limit pairs, e.g. 123456789012345678:10.
GUILD_CREATE_LIMIT_OVERRIDES=
# Discord IDs of platform admins, comma-separated. They have no guild creation limits.
PLATFORM_ADMIN_DISCORD_IDS=

# Custom domains. With these set, adding a domain attaches it to the Vercel project and verification also checks
# Vercel's status. Without them, verification checks the TXT record only and you attach domains in Vercel by hand.
# Token: https://vercel.com/account/tokens (scope it to the team that owns the project).
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Battle.net character verification (https://develop.battle.net/access/clients).
# Redirect URI: http://localhost:3000/api/battlenet/callback (plus https://<your-domain>/api/battlenet/callback)
BATTLENET_CLIENT_ID=
BATTLENET_CLIENT_SECRET=
# Default region (us | eu): item lookups and the region recorded on a link. OAuth always uses oauth.battle.net.
BATTLENET_REGION=us
# Optional: regions whose characters are read when linking (comma-separated). Default: us,eu. Regions are separate
# worlds; each guild has one, and only characters in the guild's region count for it.
# BATTLENET_REGIONS=us,eu
# Encrypts Battle.net access tokens at rest. 32 random bytes: openssl rand -base64 32
BATTLENET_TOKEN_KEY=
# Namespaces below are per region. Use a {region} template (profile-classic1x-{region}) or a region-agnostic base
# (profile-classic1x, which gets -us/-eu appended). A concrete name such as profile-classic1x-us still works: its
# region suffix is replaced for each region.
# Profile API namespace for WoW: Forever; unknown until launch.
# Try profile-classic1x-{region} (Classic Era), profile-classic-{region}, or retail profile-{region}.
BATTLENET_PROFILE_NAMESPACE=profile-classic1x-{region}
# Optional: WoW: Forever realm slugs (comma-separated). Prefix one region with eu: or us: (eu:realm-a); unprefixed
# slugs apply to both. When a region has any, only characters on those realms can be verified there; otherwise any
# realm that isn't a known Classic Era, Hardcore, Seasonal, Anniversary or progression realm.
BATTLENET_REALMS=
# Optional: namespaces read at link time to explain an empty result. Defaults to every Classic namespace and retail.
# BATTLENET_SCAN_NAMESPACES=profile-classic1x-{region},profile-classicann-{region},profile-classic-{region},profile-{region}
# Game Data namespace used to fill gaps in loot item names and icons (read in BATTLENET_REGION).
BATTLENET_STATIC_NAMESPACE=static-classic1x-{region}
# Optional: Game Data namespace for realm types (ruleset of a realm, used by guild verification). Defaults to the
# profile namespace's dynamic- twin, e.g. dynamic-classic1x-{region}.
# BATTLENET_DYNAMIC_NAMESPACE=
# Optional: TBC Anniversary namespaces (characters, guilds, realms and items of Anniversary guilds). The defaults are
# Blizzard's classicann namespaces.
# BATTLENET_ANNIVERSARY_PROFILE_NAMESPACE=profile-classicann-{region}
# BATTLENET_ANNIVERSARY_DYNAMIC_NAMESPACE=dynamic-classicann-{region}
# BATTLENET_ANNIVERSARY_STATIC_NAMESPACE=static-classicann-{region}
# Optional: realm slug to ruleset (normal, pvp, rp, hardcore), checked before Blizzard's realm type. Prefix a region
# (eu:realm-b:pvp) when the same slug differs between regions; the prefixed entry wins in its region.
# BATTLENET_REALM_RULESETS=realm-a:pvp,realm-b:normal,eu:realm-b:pvp
# Optional: the in-game guild, so the level sync reads the whole roster in one request. Only used for guilds in
# BATTLENET_GUILD_REGION (default us).
BATTLENET_GUILD_REALM=
BATTLENET_GUILD_SLUG=
# BATTLENET_GUILD_REGION=us
# Optional: override the OAuth redirect URI (defaults to <site origin>/api/battlenet/callback).
BATTLENET_REDIRECT_URI=
# Dev/e2e only: fake Battle.net with fixture characters. Refused when VERCEL_ENV=production.
BATTLENET_MOCK=

# Protects /api/cron/daily and /api/cron/battlenet-sync (Vercel Cron sends it as a Bearer token). openssl rand -hex 32
CRON_SECRET=
# Withdrawn and declined applications are deleted by the daily cron after this many days (default 180).
# The privacy policy shows this value.
APPLICATION_RETENTION_DAYS=

# Support requests (guildbook.io/support) are saved to the database and emailed through Resend (https://resend.com).
# Without RESEND_API_KEY or SUPPORT_EMAIL_TO the request is still saved and the email is logged as skipped.
# SUPPORT_EMAIL_FROM must use a domain verified in Resend, e.g. "Guildbook Support <support@guildbook.io>".
# SUPPORT_EMAIL_TO is the operator's inbox (comma-separated for several); keep it out of source.
RESEND_API_KEY=
SUPPORT_EMAIL_FROM=
SUPPORT_EMAIL_TO=support@example.com
# Record emails in memory instead of sending them (AUTH_TEST_MODE implies it).
EMAIL_MOCK=

# Test-only credentials login used by Playwright. NEVER enable in production;
# the app refuses to start if this is set while VERCEL_ENV=production.
AUTH_TEST_MODE=

# Optional: a GitHub token (no scopes needed) for the Vigil download page's release lookup. Public repositories work
# without one; it only raises the API rate limit.
GITHUB_TOKEN=

# The guild's Discord bot: the key it sends to /api/bot/* (members and groups organised from Discord). Empty: that API
# does not exist.
BOT_API_TOKEN=

# Addon sync app (Guild Professions & Recipes): where officers download it, shown on Admin > Sincronizador del addon.
# Unset: the GitHub-built release of PCX22/WOWBot.
ADDON_SYNC_DOWNLOAD_URL=
